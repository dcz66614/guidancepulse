{
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "2.8.1"
  },
  "description": "GuidancePulse \u2014 local Claude Code Hooks adapter that turns guidance reads into scoped, expirable leases checked before supported writes.",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "8.17.1",
    "jsdom": "^27.4.0",
    "playwright-core": "^1.65.1",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vite-node": "^3.2.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "name": "guidancepulse",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:config": "vitest run tests/unit/config.test.ts",
    "test:hooks-adapter": "vitest run tests/unit/hooks-adapter.test.ts",
    "test:lease-machine": "vitest run tests/unit/lease-machine.test.ts",
    "test:path-matcher": "vitest run tests/unit/path-matcher.test.ts",
    "test:privacy-sanitizer": "vitest run tests/unit/privacy-sanitizer.test.ts",
    "typecheck": "tsc --noEmit",
    "test:store": "vitest run tests/unit/store.test.ts",
    "test:privacy": "vitest run tests/unit/privacy.test.ts tests/e2e/privacy-scan.test.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:integration": "vitest run tests/integration",
    "test:offline": "vitest run tests/integration/offline.test.ts",
    "test:concurrency": "vitest run tests/unit/concurrency.test.ts",
    "test:pre-tool-use": "vitest run tests/unit/pre-tool-use.test.ts",
    "test:invalidation-boundaries": "vitest run tests/unit/invalidation-boundaries.test.ts",
    "test:phase-cli": "vitest run tests/unit/phase-cli.test.ts",
    "test:installer": "vitest run tests/unit/installer.test.ts",
    "guidancepulse": "vite-node src/cli/main.ts",
    "test:ui": "vitest run tests/unit/ui.test.ts tests/unit/ui-component.test.tsx",
    "build": "vite build",
    "demo:report": "vite-node scripts/demo-report.ts",
    "demo:screenshot": "node scripts/demo-screenshot.mjs",
    "test:ui-offline": "node scripts/check-ui-offline.mjs",
    "test:golden": "vitest run tests/unit/golden.test.ts",
    "test:oracle": "python3 tests/oracle/reference_oracle.py --self-test && python3 tests/oracle/reference_oracle.py --verify-golden",
    "test:s0": "npm run s0:gate",
    "perf:hook": "vite-node scripts/perf-hook-cli.ts",
    "repeat:s0": "vite-node scripts/repeat-s0-cli.ts",
    "s0:gate": "vite-node scripts/s0-gate.ts",
    "release:build": "node scripts/release-build.mjs",
    "release:verify": "node scripts/release-verify.mjs"
  },
  "type": "module",
  "version": "1.0.0"
}
